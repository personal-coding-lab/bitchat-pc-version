<Window x:Class="BitchatWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="bitchat" Width="900" Height="680" MinWidth="540" MinHeight="400" Background="{StaticResource Background}">
  <Border Margin="14" Background="{StaticResource Panel}" CornerRadius="10" Padding="18">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="RoomTitle" Text="# bluetooth" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <ListBox Grid.Row="1" x:Name="MessagesList" Background="Transparent" Foreground="#EEE" BorderThickness="0" FontSize="15"/>
      <DockPanel Grid.Row="2" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Send" Click="Send_Click"/><TextBox x:Name="MessageInput" AcceptsReturn="True" MinHeight="42" TextWrapping="Wrap" VerticalContentAlignment="Center" KeyDown="MessageInput_KeyDown"/></DockPanel>
    </Grid>
  </Border>
</Window>
