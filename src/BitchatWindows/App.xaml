<Application x:Class="BitchatWindows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#101114" />
    <SolidColorBrush x:Key="Panel" Color="#1B1D22" />
    <SolidColorBrush x:Key="Accent" Color="#9CF2A1" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEEEEE" /></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="11,6"/><Setter Property="Background" Value="#2B3038"/><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="#404754"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#272B32"/><Setter Property="Foreground" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="#4A5261"/><Setter Property="Padding" Value="8"/></Style>
  </Application.Resources>
</Application>
